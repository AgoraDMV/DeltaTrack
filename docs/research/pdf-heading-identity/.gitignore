# Probe output is generated, not committed — the same policy as
# ../pdf-matching-convergence/.gitignore. Every number in README.md is regenerable by
# the three commands it lists, in minutes, from the committed corpus.
#
# A result that becomes a genuinely frozen input or oracle is the explicit exception:
# add it with `git add -f`, and say here and in README.md why it is frozen. There is no
# such exception today.
results/

# Holdout working material. The bulkdata listings and the 796-entry candidate pool are
# regenerable from `select_holdout.py` and are large; the MANIFEST is not ignored,
# because bill ids, stages, package ids and artifact hashes are the provenance that
# makes the run reconstructible without committing a single source document.
holdout/cache/
holdout/pool.json

# Regenerable by confounder/population.py; the population is stated in CONFOUNDER-ROUND.md.
confounder/population.json

# Regenerable by nearfull/population.py; the population is stated in NEARFULL-ROUND.md.
nearfull/population.json

# Second holdout: same policy as the first.
holdout2/cache/
